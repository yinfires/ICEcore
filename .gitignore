# 默认拒绝：只有下方明确放行的构建文件、源码与工作区文档才进入 Git。
/*

# 本地工作区内容（即使未来调整白名单，也必须保持忽略）。
/libs/
/tmp/
!/tool/
/tool/*
!/tool/recipe-sync/
/tool/recipe-sync/*
!/tool/recipe-sync/sync.mjs
!/tool/recipe-sync/sync.test.mjs
# GitHub Wiki is a separate Git repository kept at the project root.
/wiki/
/.codegraph/
/.gradle/
/build/
/run/
/run-data/
/.idea/
/.vscode/
*.iml

# 根目录必需文件。
!/.gitattributes
!/.gitignore
!/LICENSE
!/build.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/settings.gradle
!/CHANGELOG.md
!/AGENTS.md

# 工作区规则与实现文档。
!/docs/

# 构建与模组源码。
!/gradle/
!/src/
